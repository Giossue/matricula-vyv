# Copia este archivo como .env para cambiar la configuración local (opcional).
# Sin .env, MatriculaVyV usa estos mismos valores por defecto.

# Clave solo para desarrollo local. Cámbiala si expones el sistema en otra red.
DJANGO_SECRET_KEY=solo-desarrollo-local-matriculavyv-no-usar-en-produccion
DJANGO_DEBUG=true

# Entorno de ejecución: reset_demo solo funciona cuando vale "local".
CAMPUSFLOW_ENTORNO=local

# Muestra la barra de demostración VyV (selector Versión A / Versión B).
CAMPUSFLOW_MODO_DEMO=true

# Archivo SQLite (relativo a la carpeta del proyecto).
CAMPUSFLOW_DB=db.sqlite3
